
#include <stdio.h>
#include <stdlib.h>

#define MAX 3

int queue[MAX];
int f = -1;
int r = -1;

void enqueue(int ele)
{

    if ((f == 0 && r == MAX - 1) || (f == r + 1))
    {
        printf("Queue overflow\n");
        return;
    }


    if (f == -1)
    {
        f = 0;
    }

    r = (r + 1) % MAX;
    queue[r] = ele;

    printf("The inserted element is %d\n", ele);
}

void dequeue()
{

    if (f == -1)
    {
        printf("Queue underflow\n");
        return;
    }

    int ele = queue[f];
    printf("Deleted element is %d\n", ele);


    if (f == r)
    {
        f = -1;
        r = -1;
    }
    else
    {
        f = (f + 1) % MAX;
    }
}

void display()
{
    if (f == -1)
    {
        printf("Queue is empty\n");
        return;
    }

    printf("Queue elements are: ");

    int i = f;

    while (1)
    {
        printf("%d ", queue[i]);

        if (i == r)
        {
            break;
        }

        i = (i + 1) % MAX;
    }

    printf("\n");
}

int main()
{
    int choice, ele;

    while (1)
    {
        printf("\n--- MENU ---\n");
        printf("1. Insert\n");
        printf("2. Delete\n");
        printf("3. Display\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");
        if (scanf("%d", &choice) != 1)
        {
            printf("Invalid input\n");
            return 1;
        }

        switch (choice)
        {
            case 1:
                printf("Enter the element to insert: ");
                if (scanf("%d", &ele) != 1)
                {
                    printf("Invalid input\n");
                    return 1;
                }
                enqueue(ele);
                break;

            case 2:
                dequeue();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Exiting the program\n");
                return 0;

            default:
                printf("Invalid choice. Try again.\n");
        }
    }

    return 0;
}
